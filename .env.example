NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/codetrack
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional email. Leave disabled until configured. Resend uses HTTPS, suitable for Render free.
MAIL_PROVIDER=disabled
MAIL_FROM=CodeTrack <onboarding@resend.dev>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Keep false on sleeping free hosting. An external daily request is documented instead.
ENABLE_CRON=false
CRON_SECRET=
